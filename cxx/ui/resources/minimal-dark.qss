QTableView,
QTreeView {
    accent-color: rgb(255, 160, 160);
}

QTreeView[rootSpansAllColumns="true"]::item:has-children {
    background-color: rgb(100%, 95%, 70%);
}

QLineEdit[invalid="true"] {
    border: 1px solid rgb(128, 0, 0);
    border-radius: 2px;
    padding: 2px 0px;
}

QMenu#recents {
    padding-left: 2px;
    border-width: 1px;
    border-style: solid;
    border-color: palette(shadow);
}
QMenu#recents::item QWidget {
    margin: 2px;
}
